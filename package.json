{
  "name": "vanguard-trace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:4173": "vite --host=127.0.0.1 --port=4173",
    "build": "vite build",
    "deploy": "node scripts/deploy-safe.mjs",
    "deploy:preview": "node scripts/deploy-safe.mjs --preview",
    "deploy:dirty": "node scripts/deploy-safe.mjs --allow-dirty",
    "deploy:preview:dirty": "node scripts/deploy-safe.mjs --preview --allow-dirty",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "backend:start": "npx supabase start",
    "backend:stop": "npx supabase stop",
    "backend:setup-local": "node scripts/setup-local-backend.mjs",
    "dev:full": "npm run backend:setup-local && npm run dev:4173",
    "auto-commit": "node scripts/auto-commit.mjs",
    "auto-commit:once": "node scripts/auto-commit.mjs --once"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.3.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "mapbox-gl": "^3.23.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.75.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.15.0",
    "react-type-animation": "^3.2.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.5.3",
    "vite": "^8.0.12",
    "wrangler": "^4.90.0"
  }
}
